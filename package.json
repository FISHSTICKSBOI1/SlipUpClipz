{
  "name": "slipupclipz",
  "version": "0.1.6",
  "description": "SlipUpClipz desktop soundboard and instant replay clip studio",
  "author": "SlipUpClipz",
  "main": "dist-electron/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "release:clean": "node scripts/clean-release.mjs",
    "preflight:release": "node scripts/preflight-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package": "npm run build && electron-builder --win --publish never",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package:msix": "node scripts/package-msix.mjs",
    "verify:msix": "node scripts/verify-msix.mjs",
    "package:win-all": "npm run build && electron-builder --win nsis appx --x64 --publish never",
    "release": "npm run preflight:release && npm run release:clean && npm run build && electron-builder --win --publish always && npm run verify:release",
    "license:demo": "node scripts/generate-license.mjs",
    "test:license": "npx tsx --test electron/licenseLogic.test.ts electron/deviceId.test.ts electron/billingPortal.test.ts electron/profileBackup.test.ts electron/updateChannel.test.ts shared/entitlements.test.ts src/lib/libraryPersistence.test.ts",
    "website:test": "node --test netlify/lib/email.test.cjs tests/netlify/contact-support.test.cjs tests/netlify/support-assistant.test.cjs tests/netlify/storage.test.cjs tests/netlify/idempotency.test.cjs tests/netlify/survey.test.cjs tests/netlify/intro-discount.test.cjs tests/netlify/license-validation.test.cjs tests/netlify/download-redirect.test.cjs tests/netlify/subscription-policy.test.cjs tests/netlify/device-seat.test.cjs tests/netlify/legacy-client.test.cjs tests/netlify/website-management.test.cjs tests/netlify/website-survey-reliability.test.cjs && npx tsx --test website/src/lib/checkout.test.ts website/src/lib/contactForm.test.ts website/src/lib/supportLinks.test.ts website/src/lib/shorts.test.ts website/src/lib/cropFrame.test.ts website/src/lib/audioPlayback.test.ts website/src/lib/scrollToSection.test.ts",
    "website:dev": "vite --config website/vite.config.ts",
    "website:build": "node scripts/build-website.mjs",
    "website:preview": "vite preview --config website/vite.config.ts",
    "website:netlify-dev": "npx netlify dev",
    "website:test:browser": "playwright test --config website/playwright.config.ts",
    "website:typecheck": "tsc -p website/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^36.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.slipupclipz.app",
    "productName": "SlipUpClipz",
    "copyright": "Copyright © 2026 SlipUpClipz",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/icon-16.png",
        "to": "icon-16.png"
      },
      {
        "from": "build/icon-32.png",
        "to": "icon-32.png"
      },
      {
        "from": "build/icon-64.png",
        "to": "icon-64.png"
      },
      {
        "from": "ai/server.py",
        "to": "ai-app/server.py"
      },
      {
        "from": "ai/generation_guard.py",
        "to": "ai-app/generation_guard.py"
      },
      {
        "from": "ai/reference_audio.py",
        "to": "ai-app/reference_audio.py"
      },
      {
        "from": "ai/server_temp_outputs.py",
        "to": "ai-app/server_temp_outputs.py"
      },
      {
        "from": "shared/aiComponentPin.json",
        "to": "ai-component-pin.json"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "FISHSTICKSBOI1",
      "repo": "SlipUpClipz",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SlipUpClipz",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "appx": {
      "identityName": "SlipUpClipzLLC.SlipUpClipz",
      "applicationId": "SlipUpClipz",
      "publisher": "CN=3B960933-E78C-4110-B2BE-9718E5AB5729",
      "publisherDisplayName": "SlipUpClipz LLC",
      "displayName": "SlipUpClipz",
      "languages": [
        "en-US"
      ],
      "backgroundColor": "#1C1C1C",
      "showNameOnTiles": true,
      "setBuildNumber": true,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0",
      "addAutoLaunchExtension": false,
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "microphone"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
